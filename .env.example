SPIDERHUB_LOG_LEVEL=INFO
SPIDERHUB_MYSQL_HOST=127.0.0.1
SPIDERHUB_MYSQL_PORT=3306
SPIDERHUB_MYSQL_USER=
SPIDERHUB_MYSQL_PASSWORD=
SPIDERHUB_MYSQL_DATABASE=spiderhub
SPIDERHUB_OBEY_ROBOTS=true
SPIDERHUB_REQUEST_DELAY_SECONDS=1.0
SPIDERHUB_ALLOW_FETCHER_UPGRADE=true
SPIDERHUB_ALLOW_BROWSER=true
SPIDERHUB_IMPERSONATE_TARGET=chrome
SPIDERHUB_BROWSER_CHALLENGE_WAIT_SECONDS=15
SPIDERHUB_BROWSER_HEADLESS=true
SPIDERHUB_BROWSER_STORAGE_STATE=.spiderhub/storage_state.json
